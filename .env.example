SECLAI_API_BASE=https://api.seclai.com
SECLAI_AGENT_ID=44875b9b-5f2e-4c55-a6fc-4e75fce0fce2
SECLAI_API_KEY=your_seclai_api_key
# Choose seclai or logicc. Logicc opens normal Chrome with local CDP enabled.
UPSTREAM_PROVIDER=logicc
MODEL_ID=Claude 4.6 Opus
LOGICC_MODEL_ID=claude-4.6-opus
LOGICC_CHAT_URL=https://app.logicc.com/
LOGICC_CDP_HOST=127.0.0.1
LOGICC_CDP_PORT=9223
# Conservative proxy limits; Logicc web metadata publishes only a size category.
MAX_CONTEXT_TOKENS=0
MAX_INPUT_TOKENS=0
MAX_OUTPUT_TOKENS=65536
DEFAULT_OUTPUT_TOKENS=4096
# Optional: protect the local proxy. Use this same value as SillyTavern's API key.
PROXY_API_KEY=
REQUEST_TIMEOUT_SECONDS=300
